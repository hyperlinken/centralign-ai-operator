# Copy this file to .env and fill in ONE provider. The operator auto-detects
# based on which key is set.
# Priority order: ANTHROPIC_API_KEY > OPENAI_API_KEY > GEMINI_API_KEY

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Sandbox URLs (defaults match sandbox/run_sandbox.py)
VENDOR_PORTAL_URL=http://127.0.0.1:5101
AP_SYSTEM_URL=http://127.0.0.1:5102

# Runtime config
OPERATOR_HEADLESS=false
OPERATOR_MAX_STEPS=25
OPERATOR_HITL=true
